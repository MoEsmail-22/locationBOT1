# Telegram bot token from BotFather
BOT_TOKEN=

# Supabase PostgreSQL connection string (not the https:// project URL)
DATABASE_URL=

# Comma-separated Telegram IDs allowed to administer customer data
ADMIN_IDS=

# A random value using only letters, numbers, _ or -. Keep it private.
TELEGRAM_WEBHOOK_SECRET=

# Set this after Vercel deployment, for example:
# https://your-project.vercel.app/api/webhook
WEBHOOK_URL=

# Optional import tuning
DB_UPSERT_CHUNK_SIZE=250
STORE_RAW_DATA=false

# Optional export / pool tuning (added in this fix)
# Cap "تحميل نسخة من البيانات" to N rows so it fits inside Vercel's 60s
# function timeout. Set to 0 to disable the cap (NOT recommended on Hobby).
EXPORT_ROW_LIMIT=5000
# Per-query timeout in ms. Stops the bot hanging at "جاري تجهيز ملف Excel..."
# forever if the Supabase pooler drops a connection mid-query.
DB_QUERY_TIMEOUT_MS=20000
# Per-request timeout (ms) for outgoing calls to the Telegram API.
# Prevents bot.sendMessage / bot.sendDocument from hanging forever on a
# stalled connection. 15s is enough for normal messages + small file uploads.
TELEGRAM_REQUEST_TIMEOUT_MS=15000
# How long the webhook waits for async handlers to finish before responding
# 200 to Telegram. Defaults to 55000 (leaves headroom under 60s maxDuration).
WEBHOOK_HANDLER_WAIT_MS=55000
DB_POOL_MAX=5
